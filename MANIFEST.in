include *.txt
include CHANGELOG.rst
include LICENSE
prune Output
prune doc
prune mariopy.egg-info
recursive-include mario *.json
recursive-include mario *.json.gz
recursive-include mario *.py
recursive-include mario *.stats
recursive-include mario *.csv
recursive-include mario *.xlsx
recursive-include mario *.yaml
include mario/settings/*.yaml
include mario/settings/*.py
exclude mario/settings/api_keys.yaml
